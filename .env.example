APP_ENV=local
APP_NAME=Housing Finance Core
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOAN_PRODUCT_PROVIDER=json
# 예·적금은 아직 JSON 스냅샷이 없어 갈래가 none|database 둘뿐이다. none이면
# 예·적금 구간만 "상품 후보 없음" 결측으로 남고 나머지 계산은 그대로 돈다.
SAVINGS_PRODUCT_PROVIDER=none
DATABASE_URL=postgresql+psycopg://housing:housing@localhost:5432/housing
# DATABASE_URL 대신 아래 항목을 사용하면 비밀번호에 특수문자가 있어도
# URL 인코딩 없이 안전하게 연결할 수 있습니다.
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=mydb
# DATABASE_USER=housing_api
# DATABASE_PASSWORD=change-me
PROPERTY_LISTING_JSON_PATH=sample_data/property_listings/property_listings.v1.json
LOAN_PRODUCT_BASE_JSON_PATH=sample_data/loan_products/loan_base_rows_2026-07-31.json
LOAN_PRODUCT_OPTION_JSON_PATH=sample_data/loan_products/loan_option_rows_2026-07-31.json
CORS_ORIGINS=http://localhost:3000

# --- 보고서 설명 AI (선택) ---
# 비우면 AI 설명을 생략하고 고정 템플릿 보고서만 제공한다. 기능이 꺼질 뿐
# 계산 결과는 그대로 나온다.
#
# 키는 https://aistudio.google.com/apikey 에서 발급한다.
# 이 파일(.env.example)에는 절대 실제 키를 넣지 말 것 — 커밋되는 파일이다.
# 실제 키는 .gitignore가 막아 주는 .env 에만 넣는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30

# 외부 AI로 나가기 직전 계좌번호·주민번호·연락처 형태의 값을 찾아 전송을
# 차단한다. Gemini API 무료 등급은 제출한 프롬프트를 검토·학습에 사용할 수
# 있다고 Google 약관에 명시돼 있어 기본값을 true로 둔다.
# 끄면 그 검사 없이 전송된다 — 실제 사용자 데이터로는 끄지 말 것.
REPORT_AI_EGRESS_GUARD=true
