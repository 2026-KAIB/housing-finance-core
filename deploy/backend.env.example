# /opt/housing-finance/backend.env에 복사할 백엔드 전용 설정 예시
# 실제 비밀번호와 API 키가 들어간 파일은 Git에 커밋하지 않습니다.
APP_ENV=production
APP_NAME=Housing Finance Core
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# 공급자는 구간마다 따로 켠다. 셋 다 기본값이 "끔"이므로, 여기서 빠뜨리면
# DB가 멀쩡해도 해당 구간만 조용히 막힌다 — 실거래는 화면에서 "불러오지
# 못했습니다", 예·적금은 포트폴리오 미실행으로 드러난다.
LOAN_PRODUCT_PROVIDER=database
REGION_PRICE_PROVIDER=database
SAVINGS_PRODUCT_PROVIDER=database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=mydb
DATABASE_USER=housing_api
DATABASE_PASSWORD=change-me
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

PROPERTY_LISTING_JSON_PATH=sample_data/property_listings/property_listings.v1.json
LOAN_PRODUCT_BASE_JSON_PATH=sample_data/loan_products/loan_base_rows_2026-07-31.json
LOAN_PRODUCT_OPTION_JSON_PATH=sample_data/loan_products/loan_option_rows_2026-07-31.json
CORS_ORIGINS=http://localhost:3000

# 선택 사항: 비워 두면 고정 템플릿 보고서만 생성합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
REPORT_AI_EGRESS_GUARD=true

# 보고서 PDF 보관. 끄면 `?format=pdf`가 501을 돌려주므로 대시보드의 보고서
# 뷰어가 비어 보인다. 켜는 순간 개인 재무 정보가 담긴 문서가 쌓이는 결정이라
# 기본은 꺼짐이다. 컨테이너는 read-only이고 쓸 수 있는 곳이 tmpfs `/tmp`뿐이라
# 보관 루트를 그 아래에 두며, 재시작하면 지워진다.
# REPORT_ARCHIVE_PROVIDER=filesystem
# REPORT_STORAGE_ROOT=/tmp/reports
